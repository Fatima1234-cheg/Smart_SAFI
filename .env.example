# SmartSafi - Smart City Platform
# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/smartsafi
MONGO_DB_NAME=smartsafi
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smartsafi

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# MQTT Topics
MQTT_TOPIC_WASTE=smartsafi/waste/+
MQTT_TOPIC_WATER=smartsafi/water/+
MQTT_TOPIC_AIR=smartsafi/air/+
MQTT_TOPIC_AGRICULTURE=smartsafi/agriculture/+
MQTT_TOPIC_LIGHTING=smartsafi/lighting/+

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=SmartSafi <noreply@smartsafi.com>

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartsafi.com
ADMIN_PASSWORD=changeme

# Application Settings
APP_NAME=SmartSafi
APP_VERSION=1.0.0
DEBUG=True
TESTING=False

# Rate Limiting
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_API=1000 per hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/smartsafi.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Map Configuration
MAP_DEFAULT_LAT=31.6295
MAP_DEFAULT_LNG=-7.9811
MAP_DEFAULT_ZOOM=13

# Regional Settings
REGIONS=nord,sud,est,ouest
DISTRICTS=quartier_a,quartier_b

# Security Settings
SESSION_LIFETIME=3600
REMEMBER_COOKIE_DURATION=86400
MAX_CONTENT_LENGTH=16777216

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/1
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
